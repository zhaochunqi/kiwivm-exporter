{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus 数据源",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "KiwiVM Exporter Overview",
  "uid": "kiwivm-exporter-overview",
  "tags": [
    "kiwivm",
    "bandwagon",
    "vps"
  ],
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "hostname",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(kiwivm_up, hostname)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "title": "节点信息",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "内存"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "磁盘"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SWAP"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "ram",
                "destinationType": "number"
              },
              {
                "targetField": "disk",
                "destinationType": "number"
              },
              {
                "targetField": "swap",
                "destinationType": "number"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "hostname": "主机名",
              "ip_address": "IP",
              "location": "位置",
              "os": "系统",
              "plan": "套餐",
              "ram": "内存",
              "disk": "磁盘",
              "swap": "SWAP",
              "vm_type": "虚拟化",
              "suspended": "已暂停"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "bandwagon_node_info{hostname=~\"$hostname\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "title": "VPS 运行状态",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "运行中",
                  "color": "green"
                },
                "0": {
                  "text": "已停止",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "kiwivm_up{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "API 连通性",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "正常",
                  "color": "green"
                },
                "0": {
                  "text": "失败",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "kiwivm_api_up",
          "legendFormat": "veid {{veid}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "7 天可用率",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "avg_over_time(kiwivm_up{hostname=~\"$hostname\"}[7d]) * 100",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "限流标记",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "CPU/磁盘限速",
                  "color": "orange"
                },
                "0": {
                  "text": "正常",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "kiwivm_cpu_throttled{hostname=~\"$hostname\"} or kiwivm_disk_throttled{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "CPU 当前占用",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "kiwivm_cpu_usage_percent{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      }
    },
    {
      "title": "内存当前占用",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(1 - kiwivm_mem_available_bytes{hostname=~\"$hostname\"} / kiwivm_mem_total_bytes{hostname=~\"$hostname\"}) * 100",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 9
      }
    },
    {
      "title": "SWAP 当前占用",
      "type": "gauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "(1 - kiwivm_swap_available_bytes{hostname=~\"$hostname\"} / kiwivm_swap_total_bytes{hostname=~\"$hostname\"}) * 100",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 9
      }
    },
    {
      "title": "CPU 使用率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "kiwivm_cpu_usage_percent{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "内存使用率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "(1 - kiwivm_mem_available_bytes{hostname=~\"$hostname\"} / kiwivm_mem_total_bytes{hostname=~\"$hostname\"}) * 100",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "内存可用量",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "kiwivm_mem_available_bytes{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} 可用",
          "refId": "A"
        },
        {
          "expr": "kiwivm_mem_total_bytes{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} 总量",
          "refId": "B"
        }
      ]
    },
    {
      "title": "SWAP 使用率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "(1 - kiwivm_swap_available_bytes{hostname=~\"$hostname\"} / kiwivm_swap_total_bytes{hostname=~\"$hostname\"}) * 100",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "系统负载",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "kiwivm_load1{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} 1m",
          "refId": "A"
        },
        {
          "expr": "kiwivm_load5{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} 5m",
          "refId": "B"
        },
        {
          "expr": "kiwivm_load15{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} 15m",
          "refId": "C"
        }
      ]
    },
    {
      "title": "磁盘使用率",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 33
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "kiwivm_disk_used_bytes{hostname=~\"$hostname\"} / kiwivm_disk_quota_bytes{hostname=~\"$hostname\"} * 100",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "每日流量消耗(近 30 天)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "interval": "1d",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          },
          "decimals": 0
        }
      },
      "targets": [
        {
          "expr": "increase(bandwagon_data_counter{hostname=~\"$hostname\"}[24h]) and on(hostname, instance) (kiwivm_up)",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ],
      "timeFrom": "30d"
    },
    {
      "title": "月度流量",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "bandwagon_data_counter{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} 已用",
          "refId": "A"
        },
        {
          "expr": "bandwagon_plan_monthly_data{hostname=~\"$hostname\"} - bandwagon_data_counter{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} 剩余",
          "refId": "B"
        },
        {
          "expr": "(bandwagon_data_next_reset{hostname=~\"$hostname\"} - time()) / 86400",
          "legendFormat": "{{hostname}} 距重置",
          "refId": "C"
        }
      ]
    },
    {
      "title": "流量进度(用量 vs 时间)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "blue",
                      "value": null
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "bandwagon_data_counter{hostname=~\"$hostname\"} / bandwagon_plan_monthly_data{hostname=~\"$hostname\"}",
          "legendFormat": "{{hostname}} 用量",
          "refId": "A"
        },
        {
          "expr": "1 - (bandwagon_data_next_reset{hostname=~\"$hostname\"} - time()) / 2592000",
          "legendFormat": "{{hostname}} 时间",
          "refId": "B"
        }
      ]
    },
    {
      "title": "网络带宽",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "kiwivm_network_in_bytes{hostname=~\"$hostname\"} / 300",
          "legendFormat": "{{hostname}} 接收",
          "refId": "A"
        },
        {
          "expr": "kiwivm_network_out_bytes{hostname=~\"$hostname\"} / 300",
          "legendFormat": "{{hostname}} 发送",
          "refId": "B"
        }
      ]
    },
    {
      "title": "磁盘 IO",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 57
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "targets": [
        {
          "expr": "kiwivm_disk_read_bytes{hostname=~\"$hostname\"} / 300",
          "legendFormat": "{{hostname}} 读",
          "refId": "A"
        },
        {
          "expr": "kiwivm_disk_write_bytes{hostname=~\"$hostname\"} / 300",
          "legendFormat": "{{hostname}} 写",
          "refId": "B"
        }
      ]
    },
    {
      "title": "运行状态时间线",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 57
      },
      "options": {
        "mergeValues": true,
